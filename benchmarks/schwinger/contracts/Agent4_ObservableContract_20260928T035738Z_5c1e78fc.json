      "operations": [
        {
          "angle": null,
          "controls": [],
          "gate": "H for X; Sdg then H for Y; I for Z",
          "operation": "basis_change_for_each_nonidentity_factor",
          "targets": [
            "support(P)"
          ]
        },
        {
          "angle": null,
          "controls": [],
          "gate": "CNOT_LADDER",
          "operation": "parity_compute",
          "targets": [
