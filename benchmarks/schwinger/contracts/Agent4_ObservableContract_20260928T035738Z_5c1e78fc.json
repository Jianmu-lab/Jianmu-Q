        },
        {
          "angle": "2*theta for controlled exp(-i*theta*P); decompose CRZ into two CNOTs and one-qubit RZ rotations",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CRZ",
          "operation": "controlled_central_rotation",
          "targets": [
            "last qubit in ordered support(P)"
          ]
        },
        {
          "angle": null,
          "controls": [],
          "gate": "INVERSE_OF_PREVIOUS_CLIFFORDS",
          "operation": "parity_uncompute_and_inverse_basis_change",
          "targets": [
            "support(P)"
          ]
        }
      ]
    },
    {
      "id": "controlled_endpoint_pauli_string",
      "operations": [
        {
          "angle": "pi modulo the standard controlled-P phase convention",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CONTROLLED_PAULI_STRING",
          "operation": "controlled_pauli_string_via_parity",
          "targets": [
            "support(P)"
          ]
        }
      ]
    },
    {
      "id": "scalar_potential_coefficients",
      "operations": [
        {
          "angle": "a_Ns=-(lattice_spacing*bare_gauge_coupling/2)*sum_ell[(indicator(N<=ell)-1/2)*(indicator(s<=ell)-1/2)]",
          "controls": [],
          "gate": "CLASSICAL_FORMULA",
          "operation": "classical_coefficient_loop",
          "targets": [
            "N=0,...,4",
            "s=0,...,4",
            "ell=0,...,3"
          ]
        }
      ]
    },
    {
      "id": "controlled_D_N_sigma",
      "operations": [
        {
          "angle": "sigma*a_Ns, with sigma=+1 for U and sigma=-1 for U^-1",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CRZ",
          "operation": "for_each_site_component",
          "targets": [
            "q[2*s]",
            "q[2*s+1] for s=0,...,4"
          ]
        }
      ]
    },
    {
      "id": "hamiltonian_offdiagonal_charge_preserving_blocks",
      "operations": [
        {
          "angle": "both coefficients are 3/4",
          "controls": [],
          "gate": "COMMUTING_PAULI_PAIR",
          "operation": "onsite_block_loop",
          "targets": [
            "for s=0,...,4: (X[2s]X[2s+1], Y[2s]Y[2s+1])"
          ]
        },
        {
          "angle": "coefficients (+1/4,-1/4), respectively",
          "controls": [],
          "gate": "COMMUTING_PAULI_PAIR",
          "operation": "link_block_loop_pair_1",
          "targets": [
            "for ell=0,...,3 with q=2*ell: (X[q]Z[q+1]Y[q+2], Y[q]Z[q+1]X[q+2])"
          ]
        },
        {
          "angle": "coefficients (-1/4,+1/4), respectively",
          "controls": [],
          "gate": "COMMUTING_PAULI_PAIR",
          "operation": "link_block_loop_pair_2",
          "targets": [
            "for ell=0,...,3 with q=2*ell: (X[q+1]Z[q+2]Y[q+3], Y[q+1]Z[q+2]X[q+3])"
          ]
        },
        {
          "angle": "both coefficients are -1/4",
          "controls": [],
          "gate": "COMMUTING_PAULI_PAIR",
          "operation": "link_block_loop_pair_3",
          "targets": [
            "for ell=0,...,3 with q=2*ell: (X[q]Z[q+1]Z[q+2]X[q+3], Y[q]Z[q+1]Z[q+2]Y[q+3])"
          ]
        },
        {
          "angle": "both coefficients are -1/4",
          "controls": [],
          "gate": "COMMUTING_PAULI_PAIR",
          "operation": "link_block_loop_pair_4",
          "targets": [
            "for ell=0,...,3 with q=2*ell: (X[q+1]X[q+2], Y[q+1]Y[q+2])"
          ]
        }
      ]
    },
    {
      "id": "hamiltonian_diagonal_block",
      "operations": [
        {
          "angle": "for evolution interval tau, each term h_P*P uses theta=h_P*tau",
          "controls": [],
          "gate": "PAULI_TERM_LIST",
          "operation": "collect_authoritative_diagonal_terms",
          "targets": [
            "every nonidentity Agent-3 Hamiltonian term whose Pauli label contains only I and Z, preserving its declared coefficient and qiskit_little_endian indexing"
          ]
        },
        {
          "angle": "omitted because its phases cancel exactly between E(t)^dagger and E(t); no Hamiltonian shift is introduced",
          "controls": [],
          "gate": "NO_GATE",
          "operation": "exclude_identity_phase_only_inside_heisenberg_conjugations",
          "targets": [
            "Agent-3 identity term (5/16) I"
          ]
        }
      ]
    },
    {
      "id": "controlled_E_t",
      "operations": [
        {
          "angle": "repeat N_T=trotter_steps times with delta=t/N_T; all Pauli rotations use pauli_rotation_controlled_on_ancilla_one",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CONTROLLED_S2",
          "operation": "repeat_symmetric_step",
          "targets": [
            "q[0] through q[9]"
          ]
        }
      ]
    },
    {
      "id": "controlled_E_t_dagger",
      "operations": [
        {
          "angle": "controlled_E_t with all gates reversed and angles negated",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CONTROLLED_S2_DAGGER",
          "operation": "inverse_repeat_symmetric_step",
          "targets": [
            "q[0] through q[9]"
          ]
        }
      ]
    },
    {
      "id": "controlled_wilson_dispatch",
      "operations": [
        {
          "angle": "ordered left-to-right exactly as Agent 3; circuit application is right-to-left",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CONTROLLED_WILSON_PRODUCT",
          "operation": "sample_conditioned_ordered_compose",
          "targets": [
            "z=-2: [E(-2)^dagger,D_0(-1),E(-2),E(-1)^dagger,D_1(-1),E(-1)]",
            "z=-1: [E(-1)^dagger,D_1(-1),E(-1)]",
            "z=0: []",
            "z=1: [D_2(+1)]",
            "z=2: [E(1)^dagger,D_3(+1),E(1),D_2(+1)]"
          ]
        }
      ]
    },
    {
      "id": "controlled_trajectory_V_ab",
      "operations": [
        {
          "angle": "z=sample_values.z1; j(z)=2*(z+2)+1; a,b selected by trajectory label",
          "controls": [
            "ancilla=1"
          ],
          "gate": "CONTROLLED_UNITARY_TRAJECTORY",
          "operation": "compose_in_operator_left_to_right_order",
          "targets": [
            "E(z)^dagger",
            "L_{j(z),a}",
            "E(z)",
            "W_z",
            "R_b"
          ]
        }
      ]
    }
  ],
  "reconstruction": {
    "output_components": [
      "real",
      "imag"
    ],
    "rule": "For every valid selected sample, let r_ab be the expectation from sample_z1__ab_real and s_ab the expectation from sample_z1__ab_imag. The branch convention is (|0>|phi>+|1>V_ab|psi>)/sqrt(2), so r_ab=Re(<phi|V_ab|psi>) and Sdg then H gives s_ab=+Im(<phi|V_ab|psi>). With lambda_XX=1/2, lambda_XY=i/2, lambda_YX=-i/2, lambda_YY=1/2, reconstruct Re(M)=1/2*(r_XX-s_XY+s_YX+r_YY) and Im(M)=1/2*(s_XX+r_XY-r_YX+s_YY). These coefficients already include the observable prefactor 2 and both Jordan-Wigner factors 1/2.",
    "terms": [
      {
        "coefficient": "Re output: +1/2; Im output: 0",
        "recipe_id": "sample_z1__XX_real"
      },
      {
        "coefficient": "Re output: 0; Im output: +1/2",
        "recipe_id": "sample_z1__XX_imag"
      },
      {
        "coefficient": "Re output: 0; Im output: +1/2",
        "recipe_id": "sample_z1__XY_real"
      },
      {
        "coefficient": "Re output: -1/2; Im output: 0",
        "recipe_id": "sample_z1__XY_imag"
      },
      {
        "coefficient": "Re output: 0; Im output: -1/2",
        "recipe_id": "sample_z1__YX_real"
      },
      {
        "coefficient": "Re output: +1/2; Im output: 0",
        "recipe_id": "sample_z1__YX_imag"
      },
      {
        "coefficient": "Re output: +1/2; Im output: 0",
        "recipe_id": "sample_z1__YY_real"
      },
      {
        "coefficient": "Re output: 0; Im output: +1/2",
        "recipe_id": "sample_z1__YY_imag"
      }
    ]
  },
  "schema_version": "1.1",
  "state_labels": [
    "phi",
    "psi"
  ],
  "state_preparation_interface": {
    "required_operations": [
      "prepare_phi",
      "controlled_inverse_phi_on_ancilla_one",
      "controlled_prepare_psi_on_ancilla_one"
    ],
    "treat_as_black_box": true
  },
  "time_evolution": {
    "method": "charge-preserving grouped symmetric second-order Suzuki product formula",
    "recommended_test_steps": [
      1,
      2,
      4,
      8,
      16
    ],
    "required": true,
    "step_operations": [
      {
        "angle": "for each Pauli term h_P*P in B_k use theta=h_P*t/(2*N_T)",
        "gate": "PAULI_ROTATION_SEQUENCE",
        "operation": "ordered_forward_half_steps",
        "targets": [
          "B_1 through B_21 in the exact order: five onsite blocks for s=0,...,4, followed for ell=0,...,3 by link pairs 1,2,3,4"
        ]
      },
      {
        "angle": "for each diagonal term h_P*P use theta=h_P*t/N_T",
        "gate": "PAULI_ROTATION_SEQUENCE",
        "operation": "diagonal_full_step",
        "targets": [
          "all 33 nonidentity I/Z-only Agent-3 Hamiltonian terms in their authoritative listed order"
        ]
      },
      {
        "angle": "for each Pauli term h_P*P in B_k use theta=h_P*t/(2*N_T)",
        "gate": "PAULI_ROTATION_SEQUENCE",
        "operation": "ordered_reverse_half_steps",
        "targets": [
          "B_21 through B_1"
        ]
      },
      {
        "angle": "repeat exactly N_T times; negative t supplies negative rotation angles",
        "gate": "LOOP",
        "operation": "repeat_complete_step",
        "targets": [
          "the preceding forward, diagonal, and reverse operations"
        ]
      }
    ],
    "step_symbol": "N_T",
    "symmetry_preservation_rule": "At every finite N_T, each off-diagonal block is a number-conserving commuting Pauli pair and every diagonal block commutes with Q_lat, so Q_lat and the mandatory Q=0 to Q=-1 to Q=-1 to Q=0 ordered sector path are exact. The reconstructed Gauss generators remain zero operator identities. A fixed product ordering may break C, P, or T separately at finite N_T; measure their corresponding convergence diagnostics if used, and require convergence as N_T increases. Broken spatial translations and continuum-only boosts are not imposed."
  }
}
