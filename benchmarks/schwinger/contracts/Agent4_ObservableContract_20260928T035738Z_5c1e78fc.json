        },
        {
          "angle": null,
          "controls": [],
          "gate": "CNOT_LADDER",
          "operation": "parity_compute",
          "targets": [
            "ordered support(P)"
          ]
        },
        {
          "angle": "2*theta for exp(-i*theta*P)",
          "controls": [],
          "gate": "RZ",
          "operation": "central_rotation",
          "targets": [
            "last qubit in ordered support(P)"
          ]
        },
        {
          "angle": null,
          "controls": [],
          "gate": "INVERSE_OF_PREVIOUS_CLIFFORDS",
          "operation": "parity_uncompute_and_inverse_basis_change",
          "targets": [
            "support(P)"
          ]
        }
