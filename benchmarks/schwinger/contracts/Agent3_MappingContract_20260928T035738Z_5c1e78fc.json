  "physical_sector": {
    "basis_rule": "Use exactly the 252 computational-basis states |b9...b0> satisfying sum_{j=0}^{9} b_j=5, equivalently Q_lat=0. Restrict the unshifted H_qc Pauli sum to this ordered basis, diagonalize it, sort eigenpairs by nondecreasing eigenvalue with zero-based indexing, assign phi to level_index 0 and psi to the distinct level_index 1 eigenvector. The reconstructed Gauss operators act consistently in the full 1024-dimensional space and in every charge sector reached by the observable.",
    "required": true,
    "validation_tests": [
      {
        "id": "external_state_sector_and_level_check",
        "rule": "Pass iff the Q_lat=0 basis contains exactly 252 states, Q_lat|phi>=0 and Q_lat|psi>=0, phi and psi are orthonormal, and they are respectively zero-based restricted-spectrum levels 0 and 1 without identifying the two vectors."
      },
      {
        "id": "physical_gauss_sector_check",
        "rule": "Expand each of G_0,...,G_4 from the declared E and q Pauli sums. Pass iff every Pauli coefficient cancels exactly on the full 1024-dimensional qubit space; repeat the action check on all computational states with Q_lat=-1."
      },
      {
        "id": "charge_commutator_check",
        "rule": "Pass iff exact Pauli multiplication and coefficient collection gives [H_qc,Q_lat] with no nonzero Pauli coefficient in the full ten-qubit space."
      },
