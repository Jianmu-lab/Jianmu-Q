      },
      "immutable": true,
      "name": "bare quark mass: m",
      "required_for_run": true,
      "role": "Immutable user input; downstream stages must reference this path.",
      "selected_value": 0.5,
      "source_ref": "/user_input/parameters/bare quark mass: m",
      "symbol": "bare quark mass: m",
      "type": "real",
      "unit": null
    },
    {
      "domain": {
        "source": "immutable RunSpec value"
      },
      "immutable": true,
      "name": "lattice spacing: a",
      "required_for_run": true,
      "role": "Immutable user input; downstream stages must reference this path.",
      "selected_value": 1.0,
      "source_ref": "/user_input/parameters/lattice spacing: a",
      "symbol": "lattice spacing: a",
      "type": "real",
      "unit": null
    },
    {
      "domain": {
        "source": "immutable RunSpec value"
      },
      "immutable": true,
      "name": "number of lattice site: L",
      "required_for_run": true,
      "role": "Immutable user input; downstream stages must reference this path.",
      "selected_value": 5,
      "source_ref": "/user_input/parameters/number of lattice site: L",
      "symbol": "number of lattice site: L",
      "type": "integer",
      "unit": null
    }
  ],
  "schema_version": "1.1",
  "validation_obligations": [
    {
      "description": "Confirm that phi is the zero-based level 0 eigenstate and psi is the zero-based level 1 eigenstate of H_lat within the Q_lat=0 sector, without identifying the two states.",
      "id": "external_state_sector_and_level_check",
      "severity": "fatal",
      "stage": "post_construction"
    },
    {
      "description": "Confirm that E_N-E_{N-1}-g*q_N vanishes as an operator identity at every lattice vertex under the declared reconstruction, including the intermediate charge-minus-one sector.",
      "id": "physical_gauss_sector_check",
      "severity": "fatal",
      "stage": "post_construction"
    },
    {
      "description": "Confirm that [H_lat,Q_lat]=0 in the full 1024-dimensional reduced Fock space.",
      "id": "charge_commutator_check",
      "severity": "fatal",
      "stage": "post_construction"
    },
    {
      "description": "Confirm the ordered path Q=0 -> Q=-1 -> Q=-1 -> Q=0 for the right-to-left action of psi insertion, Wilson transporter, and bar-psi insertion.",
      "id": "ordered_sector_path_check",
      "severity": "fatal",
      "stage": "pre_simulation"
    },
    {
      "description": "Confirm that the constructed Hamiltonian contains no additive vacuum-energy subtraction or target-state-dependent coefficient.",
      "id": "no_energy_shift_check",
      "severity": "fatal",
      "stage": "post_construction"
    }
  ]
}
