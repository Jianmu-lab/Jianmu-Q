{
  "model": "Schwinger model",
  "parameters": {
    "bare coupling: g": 0.5,
    "bare quark mass: m": 0.5,
    "lattice spacing: a": 1.0,
    "number of lattice site: L": 5
  },
  "observable": {
    "coordinate_convention": {
      "mode": "lattice_indices",
      "spacing_parameter": "lattice_spacing_a",
      "temporal_spacing": "same_as_spatial",
      "units": "natural_units_c_1"
    },
    "expression": "\\bar{\\psi}(zn) \\gamma^- W(zn,0) \\psi(0), n = (1,1), \\gamma^- = \\gamma^0 - \\gamma^1",
    "gauge_transporters": [
      {
        "from": "\\psi",
        "id": "Wlison line",
        "path": "straight lattice path",
        "to": "\\bar{\\psi}"
      }
    ],
    "insertions": [
      {
        "id": "psibar",
        "operator": "\\bar{\\psi}",
        "position": {
          "t1": "z1"
        }
      },
      {
        "id": "psi",
        "operator": "\\psi",
        "position": {
          "t2": "z2"
        }
      }
    ],
    "name": "user_observable",
    "observable_schema_version": "1.0",
    "ordering": "as_written",
    "requested_components": [
      "real",
      "imag"
    ],
    "sampling": {
      "maximum_points": 10000,
      "mode": "cartesian_product",
      "variables": {
        "z1": [
          -2,
          -1,
          0,
          1,
          2
        ],
        "z2": [
          0
        ]
      }
    }
  },
  "states": {
    "phi": {
      "kind": "sector_eigenstate",
      "level_index": 0,
      "quantum_numbers": {
        "charge": 0
      }
    },
    "psi": {
      "kind": "sector_eigenstate",
      "level_index": 1,
      "quantum_numbers": {
        "charge": 0
      }
    }
  },
  "continuum_conventions": {
    "lightcone": {
      "coordinate_definition": "x^plus/minus=x^0 plus/minus x^1",
      "gamma_definition": "gamma^plus/minus=gamma^0 plus/minus gamma^1",
      "normalization": 1.0
    }
  },
  "llm": "gpt-5.6-sol",
  "hardware_validation": false,
  "through": "crosscheck"
}
