  "physical_sector": {
    "basis_rule": "Use the complete 512-dimensional nine-qubit computational basis {|b8 b7 b6 b5 b4 b3 b2 b1 b0>: bj in {0,1}} with qj assigned by qubits.ordering. This basis is exactly the G_v=+1 charge-free physical Hilbert space after the open-boundary plaquette-dual reduction; no additional computational-basis filtering is applied. Construct the vacuum from the lowest eigenspace of the explicit H_qc. Construct glueball from the zero-based level_index=1 energy eigenspace of H_qc within this same 512-dimensional physical space, ordered by increasing distinct energy, without imposing any D4, time-reversal, translation, or one-form eigenvalue.",
    "required": true,
    "validation_tests": [
      {
        "id": "validate_physical_sector",
        "rule": "Pass iff the working basis has dimension 512 and, for each of the 16 listed vertex generators, multiplying its explicit ordered link Pauli factors yields IIIIIIIII with target eigenvalue +1 on every working-basis vector."
      },
      {
        "id": "validate_dual_operator_algebra",
        "rule": "Pass iff B_p is the single-Z string on the qubit assigned to p, every one of the 24 X_l operators equals its explicit link_operators Pauli string, all mapped X_l commute mutually, all mapped B_p commute mutually, and B_p anticommutes with mapped X_l exactly when p is incident on l and commutes otherwise."
      },
      {
        "id": "validate_glueball_level",
        "rule": "Pass iff the glueball state is normalized, lies in the complete reduced physical space, satisfies H_qc|glueball>=E_1|glueball> where E_1 is the zero-based level-1 distinct energy in increasing order, and no unprovided D4 or other discrete-symmetry eigenvalue is imposed."
      },
      {
        "id": "validate_unshifted_hamiltonian",
        "rule": "Pass iff H_qc contains exactly the 24 electric terms with coefficient -(bare_coupling_g^2/lattice_spacing_a)=-1 and exactly the 9 plaquette-Z terms with coefficient -(bare_coupling_g^(-2)/lattice_spacing_a)=-1 for bare_coupling_g=1 and lattice_spacing_a=1, with no identity energy shift and no state-dependent coefficient."
      }
    ]
  },
