  "physical_sector": {
    "basis_rule": "Use computational basis states |n9...n0> with n_j in {0,1}. The Q_qc=0 basis is exactly the 252 states satisfying sum_j n_j=5. The intermediate Q_qc=-1 basis is exactly the 210 states satisfying sum_j n_j=4. Restrict H_qc separately to these bases. Order eigenvalues of the Q_qc=0 block nondecreasingly with multiplicity; vacuum is zero-based level_index 0 and hadron is zero-based level_index 1. The rightmost c_(0,2) maps every supported Q_qc=0 vector into the Q_qc=-1 basis, exact evolution preserves that basis, and the left creation insertion maps it back to Q_qc=0.",
    "mapped_constraints": [
      {
        "allowed_eigenvalues": [
          "0",
          "-1"
        ],
        "operator": "Q_qc=-0.5*sum_j Z_j",
        "subspace_dimensions": {
          "-1": 210,
          "0": 252
        }
      }
    ],
    "nonempty_pass_criterion": "The enumerated popcount-5 and popcount-4 basis sets have cardinalities 252 and 210 respectively, and all required restricted operators have the stated source and destination dimensions.",
    "required": true,
    "validation_tests": [
      {
        "id": "charge_commutator_check",
        "rule": "Construct the full 1024-by-1024 matrices from the listed Pauli terms and pass iff H_qc*Q_qc-Q_qc*H_qc is exactly zero over the listed rational coefficients."
      },
      {
        "id": "external_state_sector_and_level_check",
        "rule": "Pass iff the Q_qc=0 block uses exactly the popcount-5 basis, has dimension 252, vacuum is its zero-based energy level 0, and hadron is its distinct zero-based energy level 1 without identifying their state vectors."
      },
      {
        "id": "intermediate_sector_check",
        "rule": "Pass iff c_(0,2) has zero matrix elements outside the map from popcount 5 to popcount 4, the Q_qc=-1 Hamiltonian block has dimension 210 and preserves popcount 4, and each c_(z_index,2)^dagger returns popcount 4 to popcount 5."
      },
