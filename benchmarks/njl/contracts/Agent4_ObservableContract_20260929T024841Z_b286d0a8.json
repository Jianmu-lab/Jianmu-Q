          "angle": "all RZ and RY angles are deterministically obtained from the exact matrix V; no opaque evolution primitive remains",
          "controls": [],
          "gate": "QUANTUM_SHANNON_DECOMPOSITION_TO_RZ_RY_CX",
          "operation": "finite_exact_synthesis",
          "targets": [
            "the same ordered local qubits"
