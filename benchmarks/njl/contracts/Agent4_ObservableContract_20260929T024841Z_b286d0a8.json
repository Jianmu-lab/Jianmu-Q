      "operations": [
        {
          "angle": "h_on(s)=((bare_quark_mass+wilson_parameter/lattice_spacing)/2)*(X_(2s)X_(2s+1)+Y_(2s)Y_(2s+1))+(bare_four_fermion_coupling/2)*Z_(2s)Z_(2s+1), s=0,1,2,3,4",
          "controls": [],
          "gate": "PAULI_SUM",
          "operation": "define_local_generator",
          "targets": [
            "q_(2s)",
            "q_(2s+1)"
          ]
        }
      ]
    },
    {
      "id": "link_block_h_link_l",
      "operations": [
        {
          "angle": "h_link(l)=(1/(4*lattice_spacing))*(X_b Z_(b+1) Y_(b+2)-Y_b Z_(b+1) X_(b+2)-X_(b+1) Z_(b+2) Y_(b+3)+Y_(b+1) Z_(b+2) X_(b+3))-(wilson_parameter/(4*lattice_spacing))*(X_b Z_(b+1) Z_(b+2) X_(b+3)+Y_b Z_(b+1) Z_(b+2) Y_(b+3)+X_(b+1)X_(b+2)+Y_(b+1)Y_(b+2))",
          "controls": [],
          "gate": "PAULI_SUM",
          "operation": "define_local_generator",
          "targets": [
            "q_b",
            "q_(b+1)",
            "q_(b+2)",
            "q_(b+3)",
            "b=2*l, l=0,1,2,3"
          ]
        }
      ]
    },
    {
      "id": "exact_local_block_exponential",
      "operations": [
        {
          "angle": "V=exp(-i*tau*h_local), with h_local exactly onsite_block_h_on_s or link_block_h_link_l",
