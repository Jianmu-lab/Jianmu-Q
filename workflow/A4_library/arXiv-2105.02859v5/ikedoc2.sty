% general page setup

\headheight 8pt			% no header
\headsep \headheight

\setlength{\oddsidemargin}{0.25in}	% 1.25in left margin 
\setlength{\evensidemargin}{0.25in}	% 1.25in left margin (even pages)
\setlength{\topmargin}{0.0in}		% 1in top margin
\setlength{\textwidth}{6.25in}		% 6.0in text - 1.25in rt margin
\setlength{\textheight}{8.6in}		% Body ht for 1in margins
\addtolength{\topmargin}{-\headheight}	% No header, so compensate
\addtolength{\topmargin}{-\headsep}	% for header height and separation

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% my page headings

\def\pageheading#1{\def\thepageheading{#1}}

\def\thepageheading{}

\if@twoside					% If two-sided printing.
\def\ps@myhstyle{\let\@mkboth\@gobbletwo
     	\def\@oddhead{\thepageheading\hfil}
	\def\@oddfoot{\rm\hfil\thepage\hfil}
	\def\@evenhead{\hfil\thepageheading}
	\let\@evenfoot\@oddfoot
    	\setlength{\topmargin}{-0.6in}
    	\setlength{\headheight}{0.2in}
    	\setlength{\headsep}{0.4in}
    	\setlength{\footskip}{0.3in}
    	\setlength{\textheight}{8.6in}
}
\else						% If one-sided printing.
\def\ps@myhstyle{\let\@mkboth\@gobbletwo
     	\def\@oddhead{\thepageheading\hfil}
	\def\@oddfoot{\rm\hfil\thepage\hfil}
	\def\@evenhead{\thepageheading\hfil}
	\let\@evenfoot\@oddfoot
    	\setlength{\topmargin}{-0.6in}
    	\setlength{\headheight}{0.2in}
    	\setlength{\headsep}{0.4in}
    	\setlength{\footskip}{0.3in}
    	\setlength{\textheight}{8.6in}
}
\fi

\def\apnum#1{\@apnum{\@nameuse{c@#1}}} 
\def\@apnum#1{A\number #1}  %% changed 29 Apr 86

\def\apbnum#1{\@apbnum{\@nameuse{c@#1}}} 
\def\@apbnum#1{B\number #1}  %% changed 29 Apr 86

